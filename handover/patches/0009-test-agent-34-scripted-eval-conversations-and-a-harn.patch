+# Scripted conversations for the Arbitr agent, run against real Claude with pretend tools.
+# facts: overrides on a connected, non-IBM person who can see quotes, in a DM.
+# expect_tools: tool names that must be called, in this order (others may be called too).
+# forbid_tools: must not be called. expect_pending: an approval must be waiting at the end.
+# forbid_text: regular expressions that must not appear in any reply (case-insensitive).
+# reply_language: ja | de | pt | fr | en (checked with a simple script heuristic).
+
+- id: job-status-with-reference
+  turns: ["Where is TJ48213?"]
+  expect_tools: [get_job]
+- id: job-status-digits-only
