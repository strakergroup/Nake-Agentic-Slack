+    - command: /arbitr
+      url: <YOUR_DOMAIN>/slack/events
+      description: Job Status, Daily Summary, Submit a New Job
+      usage_hint: "[job reference], my jobs, new"
+      should_escape: false
+    - command: /straker
+      url: <YOUR_DOMAIN>/slack/events
+      description: Job Status, Daily Summary, Submit a New Job
+      usage_hint: "[job reference], my jobs, new"
+      should_escape: false
+oauth_config:
+  redirect_urls:
+    - <YOUR_DOMAIN>/slack/oauth_redirect
+  scopes:
+    bot:
+      - app_mentions:read
+      - assistant:write
+      - channels:history
