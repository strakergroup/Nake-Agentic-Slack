# local, dev, uat, or production
ENVIRONMENT=local

# Slack API
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Watson Assistant
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=

# API Keys
GOOGLE_MT_API_KEY=
# tools/translation-export/mt_fill_translations.py uses Google Cloud Translation
# with Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TRANSLATION_EXPORT_MT_BATCH_SIZE=100
# Not required currently, but use later
# TAUS_API_KEY=

# Elastic APM (optional)
ELASTIC_APM_SERVER_URL=

# Document MT
DOCUMENT_MT_PDF_MAX_SIZE_MB=25
DOCUMENT_MT_QUOTE_TTL_SECONDS=43200

# Media transcription / embedding / translation quotes (default 12 hours)
MEDIA_QUOTE_TTL_SECONDS=43200

# When true (default), only Verify Admin/Owner see quote Accept UI. Non-admins
# auto-proceed AI+QE on evaluate (then still get an HT quote), and skip Document
# MT / Media quote UX.
QUOTE_ADMIN_ONLY=true

# RAY-81247: CRM member UUID that owns IBM Slack HT jobs for non-logged-in posters.
# Default is slackhtjobs@ibm.com (RAY-81247 flyway member).
HT_SERVICE_ACCOUNT_MEMBER_UUID=6BB48BEF-1EAD-4824-8724-5298CA10AA86

# Domains
SLACK_RAY_TRANSLATOR_DOMAIN=
LANGUAGECLOUD_DOMAIN=
LANGUAGECLOUD_API_DOMAIN=
STINGRAY_DOMAIN=
STREAM_PROXY_DOMAIN=
BUGLOG_DOMAIN=
VERIFY_DOMAIN=
VERIFY_API_DOMAIN=

# Database
DB_HOST_ray_integration=
DB_PORT_ray_integration=
DB_USER_ray_integration=
DB_PASSWORD_ray_integration=

DB_HOST_ray_integration_readonly=
DB_PORT_ray_integration_readonly=
DB_USER_ray_integration_readonly=
DB_PASSWORD_ray_integration_readonly=

DB_HOST_machine_translation_readonly=
DB_PORT_machine_translation_readonly=
DB_USER_machine_translation_readonly=
DB_PASSWORD_machine_translation_readonly=

DB_HOST_sitemanager=
DB_PORT_sitemanager=
DB_USER_sitemanager=
DB_PASSWORD_sitemanager=

DB_HOST_sitemanager_readonly=
DB_PORT_sitemanager_readonly=
DB_USER_sitemanager_readonly=
DB_PASSWORD_sitemanager_readonly=

DB_HOST_translators_readonly=
DB_PORT_translators_readonly=
DB_USER_translators_readonly=
DB_PASSWORD_translators_readonly=

DB_HOST_api=
DB_PORT_api=
DB_USER_api=
DB_PASSWORD_api=

DB_HOST_api_readonly=
DB_PORT_api_readonly=
DB_USER_api_readonly=
DB_PASSWORD_api_readonly=

DB_HOST_verify=
DB_PORT_verify=
DB_USER_verify=
DB_PASSWORD_verify=

DB_HOST_ray_integration_log=
DB_PORT_ray_integration_log=
DB_USER_ray_integration_log=
DB_PASSWORD_ray_integration_log=

DB_HOST_sitecommons=
DB_PORT_sitecommons=
DB_USER_sitecommons=
DB_PASSWORD_sitecommons=

# Redis
REDIS_SENTINEL_1=localhost
REDIS_SENTINEL_2=localhost
REDIS_SENTINEL_3=localhost
REDIS_SENTINEL_PORT_1=26379
REDIS_SENTINEL_PORT_2=26379
REDIS_SENTINEL_PORT_3=26379
REDIS_MASTER=
REDIS_USERNAME=
REDIS_PASSWORD=

# wb-task-consumer share files
# File Shares
FILE_API_DOMAIN=

# SAQ (Simple Async Queue) for durable background tasks (RAY-79638)
# The SAQ worker runs in-process via the FastAPI lifespan; jobs persist in
# the existing Redis instance so they survive container restarts.
SAQ_QUEUE_NAME=slack-ray-translator
SAQ_WORKER_ENABLED=true
SAQ_WORKER_CONCURRENCY=10
SAQ_FILE_SUBMISSION_QUEUE_NAME=slack-ray-translator-file-submissions
SAQ_FILE_SUBMISSION_WORKER_CONCURRENCY=3
SAQ_SMALL_FILE_SUBMISSION_QUEUE_NAME=slack-ray-translator-small-file-submissions
SAQ_SMALL_FILE_SUBMISSION_WORKER_CONCURRENCY=10
SAQ_LARGE_FILE_SUBMISSION_THRESHOLD_MB=10
SAQ_SMALL_FILE_UPLOAD_TIMEOUT_SECONDS=300
SAQ_FILE_DELIVERY_QUEUE_NAME=slack-ray-translator-file-delivery
SAQ_FILE_DELIVERY_WORKER_CONCURRENCY=10
SAQ_BACKGROUND_QUEUE_NAME=slack-ray-translator-background
SAQ_BACKGROUND_WORKER_CONCURRENCY=5
SAQ_FILE_UPLOAD_RETRIES=5
SAQ_FILE_UPLOAD_TIMEOUT_SECONDS=900
SAQ_LOGGING_RETRIES=3
SAQ_LOGGING_TIMEOUT_SECONDS=30

# Bot channel auto-translation debounce window (seconds)
# Dev alerts (BugLogHQ + Google Chat incoming webhook). Set per deployment (e.g. different secrets for prod vs UAT).
GOOGLE_CHAT_WEBHOOK=
# Deprecated (replaced by Google Chat webhooks above):
# SLACK_DEV_ALERT_CHANNEL_ID_PRODUCTION=
# SLACK_DEV_ALERT_CHANNEL_ID_NON_PRODUCTION=
# SLACK_DEV_ALERT_BOT_TOKEN=

# Evaluate quote confirmation (RAY-79115)
EVALUATE_QUOTE_TTL_SECONDS=2592000
