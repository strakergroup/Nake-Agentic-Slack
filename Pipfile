name = "straker"

[packages]
python-dotenv = "*"
fastapi = {extras = ["all"], version = ">=0.99.0,<0.100.0"}
uvicorn = {extras = ["standard"], version = "*"}
pydantic = "==1.*"
elastic-apm = "*"
slack-bolt = "*"
aiohttp = "*"
ibm-watson = "*"
# Use sqlalchemy 2 after slack-bolt supports it
sqlalchemy = "~=1.4"
mysqlclient = "!=2.2.0"
httpx = "*"
redis = "*"
cryptography = "*"
python-dateutil = "*"
babel = "*"
straker-utils = {version = "==0.1.15", index = "straker"}
ray-sdk = {version = "==0.3.5", index = "straker"}
ray-logger = {version = "==0.1.2", index = "straker"}
straker-auth = {version = "==0.1.5", index = "straker"}
buglog = {version = "==0.1.1", index = "straker"}

[dev-packages]
pytest = "*"
pytest-asyncio = "*"
coverage = "*"
flake8 = "*"
flake8-bugbear = "*"
black = "*"

[requires]
python_version = "3.11"
