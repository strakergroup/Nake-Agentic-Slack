---
apiVersion: v1
kind: Namespace
metadata:
  name: int-slack-ray-translator
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: int-slack-ray-translator
  name: int-slack-ray-translator
  namespace: int-slack-ray-translator
spec:
  selector:
    matchLabels:
      app: int-slack-ray-translator
  strategy: {}
  template:
    metadata:
      creationTimestamp: null
      labels:
        app: int-slack-ray-translator
    spec:
      containers:
      - image: docker.io/strakertech/int-slack-ray-translator:develop-latest
        name: int-slack-ray-translator
        imagePullPolicy: Always
        ports:
          - containerPort: 80
        resources:
        startupProbe:
          httpGet:
            path: /health
            port: 80
            httpHeaders:
            - name: User-Agent
              value: startup-probe
        volumeMounts:
          - name: code
            mountPath: /code/app
          - name: application-env
            mountPath: /code/.env
            subPath: .env
          - name: ibm-env
            mountPath: /code/ibm-credentials.env
            subPath: ibm-credentials.env
#kubectl create secret generic int-slack-ray-translator-env --from-file=../yaml/int/int-slack-ray-translator/.env --namespace=int-slack-ray-translator
#kubectl create secret generic int-slack-ray-ibm-env --from-file=../yaml/int/int-slack-ray-translator/ibm-credentials.env --namespace=int-slack-ray-translator
      volumes:
        - name: code
          hostPath:
            path: /mnt/data/str-local-k8s/data/apps/int-slack-ray-translator/app
        - name: application-env
          secret:
            secretName: int-slack-ray-translator-env
            items:
            - key: .env
              path: .env
        - name: ibm-env
          secret:
            secretName: int-slack-ray-ibm-env
            items:
            - key: ibm-credentials.env
              path: ibm-credentials.env
      imagePullSecrets:
      - name: regcred
status: {}
---
apiVersion: v1
kind: Service
metadata:
  annotations:
  creationTimestamp: null
  labels:
    app: int-slack-ray-translator
  name: int-slack-ray-translator-svc-np
  namespace: int-slack-ray-translator
spec:
  externalTrafficPolicy: Local
  ports:
  - name: "int-slack-ray-translator-svc-np"
    nodePort: 30600
    port: 80
    protocol: TCP
    targetPort: 80
  selector:
    app: int-slack-ray-translator
  sessionAffinity: None
  type: NodePort
status:
  loadBalancer: {}
---
